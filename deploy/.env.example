# Copy to deploy/.env on the server and fill in. Never commit the real file.
POSTGRES_USER=yunto
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=yunto

# Generate with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Origin(s) the browser will load the app from. Comma-separated.
# Use the EC2 public IP first, then swap in your domain once DNS points at it.
CORS_ORIGIN=http://YOUR_EC2_PUBLIC_IP

# Seed the demo dataset on first boot. Set false once you have real data.
SEED_ON_BOOT=true
