// Yunto platform — data model. Entities traced to the Figma admin design.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------- Users / RBAC -----------------------------
enum Role {
  SUPER_ADMIN
  SALES_MANAGER
  SALES_EMPLOYEE
  OPS_MANAGER
  OPS_EMPLOYEE
}

enum TeamKind {
  SALES
  OPERATIONS
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?   @unique
  passwordHash  String
  name          String
  avatarUrl     String?
  role          Role      @default(SALES_EMPLOYEE)
  agencyCode    String?
  teamId        String?
  team          Team?     @relation(fields: [teamId], references: [id])
  targetMonthly Int?
  targetYearly  Int?
  /// Employee profile details surfaced by the settings screens.
  dateOfBirth   DateTime?
  address       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  leads         Lead[]
  reminders     Reminder[]
  notes         Note[]
  messages      Message[]
  leaves        Leave[]
  attendance    Attendance[]
  notifications Notification[]
  attachments   Attachment[]
  payoutDetail  PayoutDetail?
  bookings      Booking[]
}

model Team {
  id        String   @id @default(cuid())
  name      String
  kind      TeamKind
  members   User[]
  createdAt DateTime @default(now())
}

// ------------------------------- Agencies -------------------------------
model Agency {
  id             String            @id @default(cuid())
  name           String
  description    String?
  logoUrl        String?
  website        String?
  creatorsCount  Int               @default(0)
  earnings       Int               @default(0)
  campaignsCount Int               @default(0)
  /// Subscription tier the agency is billed on (FREE / LITE / PRO / ...).
  planId         String?
  plan           SubscriptionPlan? @relation(fields: [planId], references: [id])
  createdAt      DateTime          @default(now())

  creators  Creator[]
  leads     Lead[]
  campaigns Campaign[]
}

// ---------------------------- Subscriptions -----------------------------
enum BillingInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

/// Product pricing tiers agencies subscribe to. Rows are the plan catalogue
/// (FREE / LITE / PRO / ULTIMATE / CUSTOM), not per-agency billing state.
model SubscriptionPlan {
  id        String          @id @default(cuid())
  name      String          @unique
  price     Int             @default(0)
  interval  BillingInterval @default(MONTHLY)
  createdAt DateTime        @default(now())

  agencies Agency[]
}

// ------------------------------- Creators -------------------------------
enum Platform {
  INSTAGRAM
  YOUTUBE
  TIKTOK
}

model Creator {
  id             String   @id @default(cuid())
  name           String
  handle         String
  avatarUrl      String?
  followers      Int      @default(0)
  avgViews       Int      @default(0)
  engagementRate Float    @default(0)
  stars          Float    @default(0)
  cpv            Float    @default(0)
  leadsCount     Int      @default(0)
  matchPct       Int      @default(0)
  location       String?
  gender         String?
  niche          String?
  platform       Platform @default(INSTAGRAM)
  listed         Boolean  @default(false)
  blacklisted    Boolean  @default(false)
  agencyId       String?
  agency         Agency?  @relation(fields: [agencyId], references: [id])
  /// Whole-percent discount the managing agency offers off this creator's rate
  /// card — the "-45% OFF" badge on the managed-by row.
  discountPct    Int?
  createdAt      DateTime @default(now())

  campaignLinks CampaignCreator[]
  calendar      CalendarContent[]
  rateCard      RateCard?
  landingPage   LandingPage?
  bookings      Booking[]
}

// --------------------------------- Leads --------------------------------
enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  CONNECTED
  DEAD
}

enum LeadIntent {
  HIGH
  MEDIUM
  LOW
}

enum DealType {
  PAID
  BARTER
}

model Lead {
  id             String     @id @default(cuid())
  brandName      String
  agencyId       String?
  agency         Agency?    @relation(fields: [agencyId], references: [id])
  contactPerson  String?
  personRole     String?
  money          String?
  engagementRate String?
  peopleCount    Int        @default(0)
  status         LeadStatus @default(NEW)
  intent         LeadIntent @default(MEDIUM)
  dealType       DealType   @default(PAID)
  channel        String?
  source         String?
  ownerId        String?
  owner          User?      @relation(fields: [ownerId], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  deliverables LeadDeliverable[]
}

// ------------------------------- Campaigns ------------------------------
enum CampaignStatus {
  DRAFT
  ACTIVE
  DONE
}

model Campaign {
  id             String         @id @default(cuid())
  name           String
  brandName      String
  agencyId       String?
  agency         Agency?        @relation(fields: [agencyId], references: [id])
  status         CampaignStatus @default(ACTIVE)
  progress       Int            @default(0)
  budget         Int            @default(0)
  engagementRate String?
  contactPerson  String?
  peopleCount    Int            @default(0)
  website        String?
  timeline       String?
  createdAt      DateTime       @default(now())

  creators  CampaignCreator[]
  invoices  Invoice[]
  contracts Contract[]
  brief     CampaignBrief?
}

model CampaignCreator {
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  creatorId  String
  creator    Creator  @relation(fields: [creatorId], references: [id])
  rating     Float?
  done       Boolean  @default(false)

  @@id([campaignId, creatorId])
}

// -------------------------------- Contacts ------------------------------
model Contact {
  id        String   @id @default(cuid())
  name      String
  company   String?
  email     String?
  phone     String?
  budget    Int?
  source    String?
  role      String?
  avatarUrl String?
  createdAt DateTime @default(now())
}

// ------------------------------- Contracts ------------------------------
enum ContractKind {
  CAMPAIGN
  CREATOR
}

model Contract {
  id         String       @id @default(cuid())
  kind       ContractKind
  title      String
  campaignId String?
  campaign   Campaign?    @relation(fields: [campaignId], references: [id])
  amount     Int?
  status     String       @default("draft")
  createdAt  DateTime     @default(now())
}

// -------------------------------- Invoices ------------------------------
enum PaymentStatus {
  PAID
  UNPAID
  OVERDUE
}

model Invoice {
  id         String        @id @default(cuid())
  number     String        @unique
  brandName  String
  campaignId String?
  campaign   Campaign?     @relation(fields: [campaignId], references: [id])
  budget     Int           @default(0)
  agencyFee  Int           @default(0)
  payout     Int           @default(0)
  dealType   DealType      @default(PAID)
  status     PaymentStatus @default(UNPAID)
  createdAt  DateTime      @default(now())
}

// --------------------------------- Polls --------------------------------
enum PollKind {
  GENERAL
  CAMPAIGN
}

model Poll {
  id        String   @id @default(cuid())
  kind      PollKind @default(GENERAL)
  question  String
  options   Json
  results   Json?
  createdAt DateTime @default(now())
}

// ------------------------------- Reminders ------------------------------
model Reminder {
  id        String   @id @default(cuid())
  title     String
  dueAt     DateTime
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id])
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// Sticky notes pinned to the dashboard. Free-form, colour-coded, per-user.
model Note {
  id        String   @id @default(cuid())
  body      String
  color     String   @default("yellow")
  pinned    Boolean  @default(false)
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------- People / HR ------------------------------
enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model Leave {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  type      String
  from      DateTime
  to        DateTime
  reason    String?
  status    LeaveStatus @default(PENDING)
  createdAt DateTime    @default(now())
}

model Attendance {
  id      String    @id @default(cuid())
  userId  String
  user    User      @relation(fields: [userId], references: [id])
  date    DateTime
  present Boolean   @default(true)
  loginAt DateTime?

  @@unique([userId, date])
}

// --------------------------------- Chat ---------------------------------
enum ChannelKind {
  TEAM
  INFLUENCER
  BRAND
  CAMPAIGN
}

model ChatChannel {
  id        String      @id @default(cuid())
  name      String
  kind      ChannelKind @default(TEAM)
  createdAt DateTime    @default(now())
  messages  Message[]
}

model Message {
  id        String      @id @default(cuid())
  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id])
  authorId  String?
  author    User?       @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime    @default(now())
}

// ------------------------------ Attachments -----------------------------
/// Generic file attachment. The owner is polymorphic: entityType names the
/// model ("Leave", "Contract", "Invoice", ...) and entityId its row id, so a
/// document can hang off any record without widening those tables.
model Attachment {
  id         String   @id @default(cuid())
  url        String
  filename   String
  mimeType   String?
  size       Int?
  uploaderId String?
  uploader   User?    @relation(fields: [uploaderId], references: [id])
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// ----------------------------- Notifications ----------------------------
enum NotificationKind {
  SYSTEM
  LEAD
  CAMPAIGN
  CONTRACT
  INVOICE
  LEAVE
  MESSAGE
  REMINDER
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  kind       NotificationKind @default(SYSTEM)
  title      String
  body       String?
  read       Boolean          @default(false)
  entityType String?
  entityId   String?
  createdAt  DateTime         @default(now())

  @@index([userId, read])
}

// ------------------------------- Calendar -------------------------------
model CalendarContent {
  id          String   @id @default(cuid())
  creatorId   String
  creator     Creator  @relation(fields: [creatorId], references: [id])
  title       String
  scheduledAt DateTime
  status      String   @default("scheduled")
  createdAt   DateTime @default(now())
}

// --------------------------- Payout / billing ---------------------------
/// A user's own payout account plus the business identity stamped on the
/// invoices they raise — Personal Information > Bank Details and the invoice
/// "Your Details" form.
///
/// `accountNumber` is sensitive, so this model is deliberately NOT wired to the
/// generic crudRouter: routes/payout.routes.ts exposes it only at /payout-details
/// with every query scoped to the caller's own userId. There is no list-all and
/// no /:id lookup, so one user's account can never be read by another.
///
/// Every column is nullable because the two screens fill in different halves of
/// the row at different times, and a PATCH must be able to create the row.
model PayoutDetail {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  /// Bank Details card.
  accountHolderName String?
  bankName          String?
  accountNumber     String?
  ifsc              String?
  upiId             String?
  verified          Boolean  @default(false)
  /// Invoice "Your Details" — the seller's billing identity.
  legalName         String?
  tradeName         String?
  gstNumber         String?
  mobile            String?
  pincode           String?
  state             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ------------------------------- Rate cards -----------------------------
/// The content formats a creator is booked for, across both platforms. Shared
/// by the barter chip set and the lead deliverables sheet.
enum DeliverableKind {
  REEL
  POST
  STORY
  CAROUSEL
  STATIC_POST
  COLLAB
  INTEGRATED_VIDEO
  DEDICATED_VIDEO
  SHORT
  UGC
  EVENT_APPEARANCE
}

/// A creator's published rate card — one whole-rupee price per deliverable —
/// plus whether they take barter and at what notional value. One row per
/// creator, so Commercials and Barter Commercials edit the same record.
model RateCard {
  id             String            @id @default(cuid())
  creatorId      String            @unique
  creator        Creator           @relation(fields: [creatorId], references: [id])
  reelRate       Int               @default(0)
  postRate       Int               @default(0)
  storyRate      Int               @default(0)
  integratedRate Int               @default(0)
  dedicatedRate  Int               @default(0)
  shortRate      Int               @default(0)
  acceptsBarter  Boolean           @default(false)
  /// Notional rupee value the creator will accept a barter deal at.
  barterValue    Int?
  /// The deliverables offered on barter — the selected chips.
  barterFormats  DeliverableKind[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

// ----------------------------- Campaign brief ---------------------------
/// The structured brief posted into a campaign thread. Key message and target
/// audience are paragraphs; guidelines / deliverables / notes are the bullet
/// lists the brief card renders.
model CampaignBrief {
  id             String   @id @default(cuid())
  campaignId     String   @unique
  campaign       Campaign @relation(fields: [campaignId], references: [id])
  keyMessage     String?
  targetAudience String?
  guidelines     String[]
  deliverables   String[]
  notes          String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ---------------------------- Lead deliverables -------------------------
/// One deliverable agreed on a lead — a row of the "Select your deliverables"
/// sheet (platform, format, how many, how many visits) plus the submitted link.
model LeadDeliverable {
  id        String          @id @default(cuid())
  leadId    String
  lead      Lead            @relation(fields: [leadId], references: [id])
  platform  Platform        @default(INSTAGRAM)
  kind      DeliverableKind
  quantity  Int             @default(1)
  visits    Int             @default(1)
  note      String?
  link      String?
  createdAt DateTime        @default(now())

  @@index([leadId])
}

// -------------------------------- Bookings ------------------------------
enum ServiceKind {
  VIDEOGRAPHER
  EDITOR
}

/// A paid service slot booked with a creator — the videographer and editor
/// "Confirm Booking" forms. `total` is the quoted rupee total the summary shows.
model Booking {
  id          String      @id @default(cuid())
  creatorId   String
  creator     Creator     @relation(fields: [creatorId], references: [id])
  bookedById  String?
  bookedBy    User?       @relation(fields: [bookedById], references: [id])
  service     ServiceKind
  scheduledAt DateTime
  hours       Int         @default(2)
  total       Int         @default(0)
  /// "Instagram Reels" / "Brand Shoot" / "YouTube Vlog" — the project chips.
  projectType String?
  location    String?
  brief       String?
  /// Add-on keys switched on in the form ("editor", "subtitles", ...).
  addons      String[]
  status      String      @default("pending")
  createdAt   DateTime    @default(now())

  @@index([creatorId])
}

// ------------------------------ Landing page ----------------------------
enum LandingTheme {
  MODERN
  DARK
  CLEAN
}

enum LandingLayout {
  CENTERED
  LEFT
}

/// A creator's public landing page (socy.io/<slug>) — the Edit Content and
/// Themes tabs of the landing-page editor.
model LandingPage {
  id           String        @id @default(cuid())
  creatorId    String        @unique
  creator      Creator       @relation(fields: [creatorId], references: [id])
  slug         String        @unique
  headline     String?
  bio          String?
  theme        LandingTheme  @default(MODERN)
  layout       LandingLayout @default(CENTERED)
  fontStyle    String?
  contactTime  String?
  services     String[]
  hideInsights Boolean       @default(false)
  published    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  links LandingLink[]
}

/// One link row on a landing page. Sorted by `sortOrder`, not createdAt — the
/// creator reorders these, so /landing-links passes an explicit CrudOptions.
model LandingLink {
  id        String      @id @default(cuid())
  pageId    String
  page      LandingPage @relation(fields: [pageId], references: [id])
  label     String
  url       String
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())

  @@index([pageId])
}
