DATABASE_URL="postgresql://yunto:yunto@localhost:5432/yunto?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=3001
CORS_ORIGIN="http://localhost:5173"

# --- S3 file uploads (optional) ---------------------------------------------
# Leave S3_BUCKET empty to disable uploads: the server boots normally and
# POST /api/uploads/presign returns 501.
S3_BUCKET=""
AWS_REGION="ap-south-1"
# Optional. Omit both to use the AWS default provider chain (EC2 instance role).
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Optional CDN origin serving the bucket; defaults to the S3 virtual-host URL.
S3_PUBLIC_BASE_URL=""
# Presigned URL lifetime in seconds.
S3_PRESIGN_EXPIRES=900
